## Interface: 120005
## Title: Parchment
## Notes: System-agnostic TTRPG toolkit - character sheets, initiative, feats and spellbooks.
## Author: Parchment
## Version: 0.3.0
## SavedVariables: ParchmentSystemDB, ParchmentCharDB, ParchmentItemDB, ParchmentPackDB, ParchmentDB

# Embedded libraries (load first so LibStub and the Ace3 modules exist).
embeds.xml

# Data layer: schema validation and the JSON/TOML codecs used by import/export.
# Parchment ships with no ruleset; systems are imported by the user at runtime.
Schema.lua
JSON.lua
TOML.lua

# Core: addon init, SavedVariables wiring, data access API, slash commands.
Core.lua
Modules\Comm.lua
Modules\Systems.lua
Modules\Packs.lua
Modules\Picks.lua
Modules\ChatLinks.lua
Modules\Dice.lua

# Shared UI chrome (defines ns.UI; must load before panels that use it).
UI\Window.lua
UI\Dialogs.lua
UI\Widgets.lua
UI\ChatLinkUI.lua
# The hub (management window). Loads before the files that register panels.
UI\HubUI.lua

# Modules (logic) and their UI. Each registers its opener with Core.
Modules\Items.lua
Modules\CharacterSheet.lua
UI\CharacterSheetUI.lua
Modules\Sharing.lua
Modules\Party.lua
UI\PartyUI.lua
Modules\InitiativeTracker.lua
UI\InitiativeUI.lua
Modules\ImportExport.lua
UI\ImportExportUI.lua
UI\HubPanels.lua
Modules\Feats.lua
UI\FeatsUI.lua
Modules\Spells.lua
UI\SpellbookUI.lua
Modules\Homebrew.lua
Modules\CharacterEditor.lua
UI\CharacterForm.lua
UI\CharacterEditorUI.lua
UI\CharacterWizardUI.lua
UI\HomebrewUI.lua
UI\ItemWizardUI.lua
UI\ConfigUI.lua
Modules\Minimap.lua
